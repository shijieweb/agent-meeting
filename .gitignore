# ===== agent-meeting monorepo 全局忽略 =====

# 运行时数据（服务自动生成，含真实聊天消息，严禁提交）
server/data/
data/

# Python 缓存
__pycache__/
*.pyc

# 运行日志
*.log
.server.log
.agent.log
.loop.log
.auto.log
_reply_tmp.txt

# 生成的方案草稿（AI 产出，可再生产）
_doc_*.json
_doc_*.md

# 虚拟环境
.venv/
venv/

# 编辑器 / OS
.DS_Store
.idea/

# ===== QA / 隔离测试运行数据（非生产, 跑测试自动生成）=====
server/data_qa_test/
server/data_test_8011/
server/server/
server/test_*
